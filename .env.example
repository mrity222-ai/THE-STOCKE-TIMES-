# Server Configuration
PORT=3000
NODE_ENV=development
SITE_URL=https://thestocktimes.online
ADMIN_URL=https://thestocktimes.online

# AI & Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_ARTICLES_PER_DAY=3
AI_TARGET_COUNTRIES=US,UK

# Market Data
FINNHUB_API_KEY=

# Database (MySQL / Cloud SQL) - Falls back to in-memory store if offline
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=finance_pulse_db
DB_PORT=3306

# Redis / Queue (Optional - Runs in direct execution mode if omitted)
REDIS_URL=

# SMTP Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM=

# Admin Authentication
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_EXPIRY_MINUTES=720

# Monetization & AdSense
ADSENSE_PUB_ID=pub-5020716602157264
VITE_ADSENSE_PUB_ID=pub-5020716602157264

# Client API Base URL
VITE_API_BASE_URL=/api
